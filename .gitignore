config.js

# Python
.venv/
__pycache__/
*.pyc

# XauOrderPad Auto-Test audit logs (browser-downloaded by default; the dir
# only appears if the optional backend persist endpoint is ever wired up).
XauOrderPad/audit/

# AWS deploy secrets - NEVER commit.
# The .pem is the ONLY way to decrypt the EC2 Windows Administrator password and
# it grants SSH to the box. If it reaches a remote it cannot be un-published;
# the instance would have to be rebuilt and the key pair rotated.
*.pem
*.ppk
# unanchored (no leading path) so it matches deploy/ AND XauOrderPad/deploy/
state.json

# Android signing key - NEVER commit. Same reasoning as the .pem above, plus:
# lose it and you can never ship an upgrade OVER the installed APK (Android
# refuses an update signed by a different key) - you'd have to uninstall first.
# Back it up OUTSIDE this repo.
*.jks
*.keystore
keystore.properties

# android/.env holds the release-signing keystore + key passwords, fed to the build
# container by docker compose. A committed password defeats the whole "keystore lives
# outside the repo" design, so ignore every .env.
.env
*/.env
android/.env

# The API token for the local/LAN dev server. Grants order placement on whatever
# account MT5 is logged into -- treat it like the .pem above.
.token.local
*.token.local
# PER-INSTANCE tokens (.token.a1.local, .token.a2.local, ...). The multi-instance
# launcher writes one token file per instance, and the two patterns above do NOT
# match them: `*.token.local` only matches names ENDING in ".token.local", while
# these end in ".<instance>.local". Without this line `.token.a1.local` is an
# untracked, NOT-ignored live trading token, one `git add -A` from being published.
.token.*.local
*.token.*.local

# Operator login cheat-sheets: they contain a live API token verbatim (even a demo one
# grants order placement), so keep them local. The PROCEDURE lives in deploy/README.md;
# this file is the fill-in-the-blanks copy with the real token.
XauOrderPad/deploy/LOGIN_EC2.md

# mTLS material for the public EC2 deployment. NEVER commit any of it.
#
# ca.key is the crown jewel: it MINTS CLIENT IDENTITIES. Anyone holding it can issue
# themselves a certificate the server will accept, and mTLS is then worth nothing --
# they still need the API token, but you have handed away the outer layer entirely.
# It belongs on your laptop and nowhere else: not the box, not the repo, not a remote.
#
# client.p12 IS a trading identity. server.key impersonates the server.
# Ignore the whole directory rather than the extensions, so a stray intermediate,
# CSR, serial file or backup cannot slip through a pattern that did not anticipate it.
XauOrderPad/deploy/certs/
certs/
*.p12
*.pfx
*.key
*.csr

# The LOCAL (LAN) mTLS material: a second server cert (SAN = the LAN IP) signed by the same CA,
# plus the downloaded caddy.exe and its access logs. server.key is already covered by *.key above;
# ignore the whole dir + binary so nothing local leaks. See start_server.bat `tls` mode.
XauOrderPad/deploy/certs-lan/
certs-lan/
XauOrderPad/deploy/caddy.exe
XauOrderPad/deploy/logs/

# Server stdout/stderr captured when launching detached. Machine-local noise, and
# the banner echoes the LAN URL, so keep it out of the repo.
XauOrderPad/.server.*.log

# Android build output
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Phone address remembered by deploy.bat. Machine-local, and the wireless-debug
# port changes on every toggle, so it is noise in a diff.
android/.deploy-phone
