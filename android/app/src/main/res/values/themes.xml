<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose supplies the real theme (MaterialTheme in MainActivity). This exists only
      so the Activity has a valid android:theme before Compose takes over. Without it
      the app flashes a white system background on launch, which on a dark trading
      screen is jarring.
    -->
    <style name="Theme.XauOrderPad" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#101214</item>
        <item name="android:navigationBarColor">#101214</item>
        <item name="android:windowBackground">#101214</item>

        <!--
          Android 12+ system splash (shown on COLD start, before Compose can draw). By default it
          paints the LAUNCHER icon (the candlesticks) on a flat ground, which read as an unrelated
          screen ahead of the "Om!" welcome. Point it at the gold emblem on the welcome's own dark
          ground instead, so the splash IS the start of the Om! moment and cross-dissolves into it
          (MainActivity sets the exit animation). minSdk is 34, so these API-31 attrs always apply.
        -->
        <item name="android:windowSplashScreenBackground">#0A0B0D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_emblem</item>
    </style>
</resources>
