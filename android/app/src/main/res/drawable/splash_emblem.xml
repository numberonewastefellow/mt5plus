<?xml version="1.0" encoding="utf-8"?>
<!--
  The cold-start SPLASH icon (Android 12+ system splash; see themes.xml). Deliberately NOT the
  launcher icon: the launcher/home icon stays the red+green candlesticks, but the splash shows a
  gold double-ring so it matches the "Om!" welcome that immediately follows and cross-dissolves in
  (MainActivity.splashScreen exit listener). Centre is left empty on purpose — the welcome's ॐ
  glyph lands there as the emblem "completes".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- gold outer ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E7B94D"
        android:strokeWidth="3"
        android:pathData="M22,54 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0" />

    <!-- gold inner aura ring (dimmer) -->
    <path
        android:fillColor="#00000000"
        android:strokeAlpha="0.5"
        android:strokeColor="#E7B94D"
        android:strokeWidth="2"
        android:pathData="M32,54 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0" />
</vector>
