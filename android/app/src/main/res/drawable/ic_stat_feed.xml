<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification status-bar icon. Android renders these as a SILHOUETTE from the alpha
  channel only, so it must be a solid white shape on transparent. Any colour here is
  discarded. A candlestick reads clearly at status-bar size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- left candle: wick + body -->
    <path android:fillColor="#FFFFFF" android:pathData="M6.25,2h1.5v20h-1.5z" />
    <path android:fillColor="#FFFFFF" android:pathData="M4.5,7h5v9h-5z" />

    <!-- right candle: wick + body -->
    <path android:fillColor="#FFFFFF" android:pathData="M16.25,2h1.5v20h-1.5z" />
    <path android:fillColor="#FFFFFF" android:pathData="M14.5,5h5v6h-5z" />
</vector>
